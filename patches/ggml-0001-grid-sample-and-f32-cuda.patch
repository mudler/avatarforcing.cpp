+// ggml_compute_forward_grid_sample
+//
+// Bilinear, zero padding, align_corners = false. The arithmetic follows the
+// PyTorch CPU kernel (GridSamplerKernel.cpp, float32):
+//
+//   ix = (gx + 1) * (W_in / 2) - 0.5      (three separately rounded operations)
+//   x0 = floor(ix), w = ix - x0, e = 1 - w  (same for y: y0, n, s = 1 - n)
+//   nw = s*e, ne = s*w, sw = n*e, se = n*w
+//   out = fma(v_se, se, fma(v_sw, sw, fma(v_ne, ne, v_nw * nw)))
+//
+// The fused multiply-adds are explicit, and the function must get no others
+// from the compiler, so that the CPU and GPU kernels give the same bits.
+
+#if defined(__clang__)
+#define GGML_GS_NO_CONTRACT
+#elif defined(__GNUC__)
+#define GGML_GS_NO_CONTRACT __attribute__((optimize("fp-contract=off")))
+#else
+#define GGML_GS_NO_CONTRACT
+#endif
+
+GGML_GS_NO_CONTRACT
+static void ggml_grid_sample_rows(const float * feat, int w_in, int h_in, int c, int b_feat,
+                                  const float * grid, int w, int h, float * out,
+                                  int64_t row_begin, int64_t row_end,
+                                  int * x0s, int * y0s, float * wts) {
+#if defined(__clang__)
+#pragma clang fp contract(off)
+#endif
+    const float half_w = (float) w_in * 0.5f;
+    const float half_h = (float) h_in * 0.5f;
+    const size_t plane      = (size_t) w_in * h_in;
+    const size_t feat_batch = plane * c;
+    const size_t grid_plane = (size_t) w * h;
+    for (int64_t r = row_begin; r < row_end; ++r) {
+        const int bi = (int) (r / h);
+        const int y  = (int) (r % h);
+        const float * feat_b = feat + (b_feat == 1 ? 0 : (size_t) bi * feat_batch);
+        const float * gx_row = grid + (size_t) bi * 2 * grid_plane + (size_t) y * w;
+        const float * gy_row = gx_row + grid_plane;
+        float * out_row = out + (size_t) bi * c * grid_plane + (size_t) y * w;
+        for (int x = 0; x < w; ++x) {
+            const float ax = gx_row[x] + 1.0f;
+            const float bx = ax * half_w;
+            const float ix = bx - 0.5f;
+            const float ay = gy_row[x] + 1.0f;
+            const float by = ay * half_h;
+            const float iy = by - 0.5f;
+            const float fx = floorf(ix);
+            const float fy = floorf(iy);
+            const float wx = ix - fx;
+            const float ex = 1.0f - wx;
+            const float ny = iy - fy;
+            const float sy = 1.0f - ny;
+            wts[4*x + 0] = sy * ex;
+            wts[4*x + 1] = sy * wx;
+            wts[4*x + 2] = ny * ex;
+            wts[4*x + 3] = ny * wx;
+            x0s[x] = (int) fx;
+            y0s[x] = (int) fy;
+        }
+        for (int ch = 0; ch < c; ++ch) {
+            const float * src = feat_b + ch * plane;
+            float * dst = out_row + ch * grid_plane;
+            for (int x = 0; x < w; ++x) {
+                const int x0 = x0s[x], y0 = y0s[x], x1 = x0 + 1, y1 = y0 + 1;
+                const bool in_x0 = x0 >= 0 && x0 < w_in, in_x1 = x1 >= 0 && x1 < w_in;
+                const bool in_y0 = y0 >= 0 && y0 < h_in, in_y1 = y1 >= 0 && y1 < h_in;
+                const float v_nw = (in_y0 && in_x0) ? src[(size_t) y0 * w_in + x0] : 0.0f;
+                const float v_ne = (in_y0 && in_x1) ? src[(size_t) y0 * w_in + x1] : 0.0f;
+                const float v_sw = (in_y1 && in_x0) ? src[(size_t) y1 * w_in + x0] : 0.0f;
+                const float v_se = (in_y1 && in_x1) ? src[(size_t) y1 * w_in + x1] : 0.0f;
+                float acc = v_nw * wts[4*x + 0];
+                acc = fmaf(v_ne, wts[4*x + 1], acc);
+                acc = fmaf(v_sw, wts[4*x + 2], acc);
+                acc = fmaf(v_se, wts[4*x + 3], acc);
+                dst[x] = acc;
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_grid_sample(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * feat = dst->src[0];
+    const ggml_tensor * grid = dst->src[1];
+    GGML_ASSERT(feat->type == GGML_TYPE_F32 && grid->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+
+    const int w = (int) dst->ne[0];
+    const int h = (int) dst->ne[1];
+    const int b = (int) dst->ne[3];
+    const int64_t rows = (int64_t) b * h;
+    const int64_t per  = (rows + params->nth - 1) / params->nth;
+    const int64_t r0   = std::min<int64_t>(rows, per * params->ith);
+    const int64_t r1   = std::min<int64_t>(rows, r0 + per);
+    if (r0 >= r1) {
+        return;
+    }
+    std::vector<int>   x0s(w), y0s(w);
+    std::vector<float> wts(4 * (size_t) w);
+    ggml_grid_sample_rows((const float *) feat->data, (int) feat->ne[0], (int) feat->ne[1], (int) feat->ne[2],
+                          (int) feat->ne[3], (const float *) grid->data, w, h, (float *) dst->data, r0, r1,
+                          x0s.data(), y0s.data(), wts.data());
+}
