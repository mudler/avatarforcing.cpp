diff --git a/src/ggml-cuda/grid-sample.cu b/src/ggml-cuda/grid-sample.cu
new file mode 100644
index 00000000..f0f6660e
--- /dev/null
+++ b/src/ggml-cuda/grid-sample.cu
@@ -0,0 +1,78 @@
+#include "grid-sample.cuh"
+
+// Bilinear grid sampling, zero padding, align_corners = false. Same
+// arithmetic as the CPU kernel (ggml-cpu/ops.cpp): every operation uses an
+// explicitly rounded intrinsic, so nvcc cannot contract it, and the bilinear
+// sum is an explicit chain of fused multiply-adds. The result is bit-identical
+// to the CPU op.
+//
+// One thread per output pixel (x, y, b); it computes the corner weights once
+// and loops over the channels. Threads of a warp hold neighbouring x, so the
+// stores are coalesced and the gathers hit the same cache lines.
+static __global__ void grid_sample_f32(const float * __restrict__ feat, const float * __restrict__ grid,
+                                       float * __restrict__ dst, const int w_in, const int h_in, const int c,
+                                       const int b_feat, const int w, const int h, const int b) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t grid_plane = (int64_t) w * h;
+    if (i >= grid_plane * b) {
+        return;
+    }
+    const int     bi  = (int) (i / grid_plane);
+    const int64_t pix = i - (int64_t) bi * grid_plane;
+
+    const float * g = grid + (int64_t) bi * 2 * grid_plane;
+    const float half_w = __fmul_rn((float) w_in, 0.5f);
+    const float half_h = __fmul_rn((float) h_in, 0.5f);
+    const float ix = __fsub_rn(__fmul_rn(__fadd_rn(g[pix], 1.0f), half_w), 0.5f);
+    const float iy = __fsub_rn(__fmul_rn(__fadd_rn(g[grid_plane + pix], 1.0f), half_h), 0.5f);
+    const float fx = floorf(ix);
+    const float fy = floorf(iy);
+    const float wx = __fsub_rn(ix, fx);
+    const float ex = __fsub_rn(1.0f, wx);
+    const float ny = __fsub_rn(iy, fy);
+    const float sy = __fsub_rn(1.0f, ny);
+    const float w_nw = __fmul_rn(sy, ex);
+    const float w_ne = __fmul_rn(sy, wx);
+    const float w_sw = __fmul_rn(ny, ex);
+    const float w_se = __fmul_rn(ny, wx);
+    const int x0 = (int) fx, y0 = (int) fy, x1 = x0 + 1, y1 = y0 + 1;
+    const bool in_x0 = x0 >= 0 && x0 < w_in, in_x1 = x1 >= 0 && x1 < w_in;
+    const bool in_y0 = y0 >= 0 && y0 < h_in, in_y1 = y1 >= 0 && y1 < h_in;
+    const bool m_nw = in_y0 && in_x0, m_ne = in_y0 && in_x1, m_sw = in_y1 && in_x0, m_se = in_y1 && in_x1;
+    const int64_t o_nw = (int64_t) y0 * w_in + x0;
+    const int64_t o_ne = o_nw + 1;
+    const int64_t o_sw = o_nw + w_in;
+    const int64_t o_se = o_sw + 1;
+
+    const int64_t plane = (int64_t) w_in * h_in;
+    const float * src = feat + (b_feat == 1 ? 0 : (int64_t) bi * plane * c);
+    float * out = dst + (int64_t) bi * c * grid_plane + pix;
+    for (int ch = 0; ch < c; ++ch) {
+        const float v_nw = m_nw ? __ldg(src + o_nw) : 0.0f;
+        const float v_ne = m_ne ? __ldg(src + o_ne) : 0.0f;
+        const float v_sw = m_sw ? __ldg(src + o_sw) : 0.0f;
+        const float v_se = m_se ? __ldg(src + o_se) : 0.0f;
+        float acc = __fmul_rn(v_nw, w_nw);
+        acc = __fmaf_rn(v_ne, w_ne, acc);
+        acc = __fmaf_rn(v_sw, w_sw, acc);
+        acc = __fmaf_rn(v_se, w_se, acc);
+        out[(int64_t) ch * grid_plane] = acc;
+        src += plane;
+    }
+}
+
+void ggml_cuda_op_grid_sample(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * feat = dst->src[0];
+    const ggml_tensor * grid = dst->src[1];
+    GGML_ASSERT(feat->type == GGML_TYPE_F32 && grid->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(feat) && ggml_is_contiguous(grid) && ggml_is_contiguous(dst));
+
+    const int w = (int) dst->ne[0];
+    const int h = (int) dst->ne[1];
+    const int b = (int) dst->ne[3];
+    const int64_t total  = (int64_t) w * h * b;
+    const int64_t blocks = (total + CUDA_GRID_SAMPLE_BLOCK_SIZE - 1) / CUDA_GRID_SAMPLE_BLOCK_SIZE;
+    grid_sample_f32<<<blocks, CUDA_GRID_SAMPLE_BLOCK_SIZE, 0, ctx.stream()>>>(
+        (const float *) feat->data, (const float *) grid->data, (float *) dst->data,
+        (int) feat->ne[0], (int) feat->ne[1], (int) feat->ne[2], (int) feat->ne[3], w, h, b);
+}
