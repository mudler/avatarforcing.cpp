diff --git a/src/ggml-cuda/chan-affine.cu b/src/ggml-cuda/chan-affine.cu
new file mode 100644
index 00000000..5e3dca12
--- /dev/null
+++ b/src/ggml-cuda/chan-affine.cu
@@ -0,0 +1,75 @@
+#include "chan-affine.cuh"
+
+#define CUDA_CHAN_AFFINE_BLOCK_SIZE 256
+
+static __global__ void chan_affine_leaky_f32(const float * __restrict__ x, const float * __restrict__ m,
+                                             const float * __restrict__ a, float * __restrict__ dst, const int64_t n,
+                                             const int64_t hw, const int C, const int m_c, const int m_b,
+                                             const int a_c, const int a_b, const float negative_slope) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t r = i / hw;
+    const int     c = (int) (r % C);
+    const int     b = (int) (r / C);
+    float t = x[i];
+    if (m) {
+        t = __fmul_rn(t, m[(c % m_c) + (int64_t) (b % m_b) * m_c]);
+    }
+    t = __fadd_rn(t, a[(c % a_c) + (int64_t) (b % a_b) * a_c]);
+    // the expression of op_leaky_relu in unary.cu
+    dst[i] = fmaxf(t, 0) + fminf(t, 0.0f) * negative_slope;
+}
+
+static bool chan_vector_ok(const ggml_tensor * v, const ggml_tensor * x) {
+    return v->type == GGML_TYPE_F32 && ggml_is_contiguous(v) && v->ne[0] == 1 && v->ne[1] == 1 &&
+           (v->ne[2] == 1 || v->ne[2] == x->ne[2]) && (v->ne[3] == 1 || v->ne[3] == x->ne[3]);
+}
+
+static bool ranges_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    const char * a0 = (const char *) a->data;
+    const char * b0 = (const char *) b->data;
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+bool ggml_cuda_chan_affine_leaky_supported(const ggml_tensor * mul, const ggml_tensor * add, const ggml_tensor * leaky) {
+    const ggml_tensor * x = mul ? mul->src[0] : add->src[0];
+    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || leaky->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(leaky) || !ggml_are_same_shape(x, leaky)) {
+        return false;
+    }
+    if (mul && (mul->type != GGML_TYPE_F32 || add->src[0] != mul || !chan_vector_ok(mul->src[1], x))) {
+        return false;
+    }
+    if (add->type != GGML_TYPE_F32 || leaky->src[0] != add || !chan_vector_ok(add->src[1], x)) {
+        return false;
+    }
+    // The graph allocator planned the memory for the separate ops: the output
+    // may reuse memory of inputs that are dead by then. The fused kernel reads
+    // all inputs while it writes, so the output may only coincide exactly
+    // with x (element-wise in place) and must not touch the vectors.
+    if (leaky->data != x->data && ranges_overlap(leaky, x)) {
+        return false;
+    }
+    if (ranges_overlap(leaky, add->src[1]) || (mul && ranges_overlap(leaky, mul->src[1]))) {
+        return false;
+    }
+    return true;
+}
+
+void ggml_cuda_op_chan_affine_leaky(ggml_backend_cuda_context & ctx, const ggml_tensor * mul, const ggml_tensor * add,
+                                    ggml_tensor * leaky) {
+    const ggml_tensor * x = mul ? mul->src[0] : add->src[0];
+    const ggml_tensor * m = mul ? mul->src[1] : nullptr;
+    const ggml_tensor * a = add->src[1];
+    float negative_slope;
+    memcpy(&negative_slope, leaky->op_params, sizeof(float));
+    const int64_t n  = ggml_nelements(x);
+    const int64_t hw = x->ne[0] * x->ne[1];
+    const int64_t blocks = (n + CUDA_CHAN_AFFINE_BLOCK_SIZE - 1) / CUDA_CHAN_AFFINE_BLOCK_SIZE;
+    chan_affine_leaky_f32<<<blocks, CUDA_CHAN_AFFINE_BLOCK_SIZE, 0, ctx.stream()>>>(
+        (const float *) x->data, m ? (const float *) m->data : nullptr, (const float *) a->data, (float *) leaky->data,
+        n, hw, (int) x->ne[2], m ? (int) m->ne[2] : 1, m ? (int) m->ne[3] : 1, (int) a->ne[2], (int) a->ne[3],
+        negative_slope);
+}
