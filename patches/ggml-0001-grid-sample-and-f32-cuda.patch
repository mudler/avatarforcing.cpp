+// Stride 1, dilation 1, contiguous WHCN input, KW x KH kernel: one block per
+// TW x TH output tile of one (channel, batch) plane. The input tile and its
+// halo go to shared memory (zeros outside the image), the taps to registers.
+// The taps are summed in the order of conv2d_dw_kernel (ky outer, kx inner,
+// one fused multiply-add each); a zero tap leaves the sum unchanged, so the
+// result is the same as the generic kernel's.
+template <int KW, int KH, int TW, int TH>
+static __global__ void __launch_bounds__(TW * TH)
+conv2d_dw_tiled_f32(const float * __restrict__ input, const float * __restrict__ kernel, float * __restrict__ output,
+                    const int in_w, const int in_h, const int out_w, const int out_h, const int pad_x, const int pad_y,
+                    const int channels) {
+    constexpr int SW = TW + KW - 1;
+    constexpr int SH = TH + KH - 1;
+    __shared__ float tile[SH][SW];
+
+    const int plane = blockIdx.z;            // batch * channels + channel
+    const int c     = plane % channels;
+    const int ox0   = blockIdx.x * TW;
+    const int oy0   = blockIdx.y * TH;
+    const float * in = input + (int64_t) plane * in_w * in_h;
+    const int tid = threadIdx.y * TW + threadIdx.x;
+
+    for (int i = tid; i < SW * SH; i += TW * TH) {
+        const int sy = i / SW, sx = i - sy * SW;
+        const int iy = oy0 + sy - pad_y, ix = ox0 + sx - pad_x;
+        tile[sy][sx] = (iy >= 0 && iy < in_h && ix >= 0 && ix < in_w) ? in[(int64_t) iy * in_w + ix] : 0.0f;
+    }
+    float k[KH][KW];
+#pragma unroll
+    for (int ky = 0; ky < KH; ++ky) {
+#pragma unroll
+        for (int kx = 0; kx < KW; ++kx) {
+            k[ky][kx] = kernel[(c * KH + ky) * KW + kx];
+        }
+    }
+    __syncthreads();
+
+    const int ox = ox0 + threadIdx.x, oy = oy0 + threadIdx.y;
+    if (ox >= out_w || oy >= out_h) {
+        return;
+    }
+    float acc = 0.0f;
+#pragma unroll
+    for (int ky = 0; ky < KH; ++ky) {
+#pragma unroll
