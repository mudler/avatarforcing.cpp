+#ifdef GGML_CUDA_CONV2D_IGEMM
+// Implicit-GEMM F32 convolution: C[m, n] = sum_k A[m, k] * B[k, n] with
+// m = output pixel (ow, oh, batch), n = output channel and
+// k = (input channel, ky, kx). A is gathered from the input on the fly (no
+// im2col buffer). Both operands go through double-buffered shared memory in
+// BK-wide slices (the next slice is fetched into registers while the current
+// one is multiplied), and every thread accumulates a TM x TN register tile
+// made of float4 groups: m = tx*4 + g*TX*4 + e, n = ty*4 + h*TY*4 + e.
+//
+// Every output is one fmaf chain over k = 0 .. K-1 in order, in float32.
+// The kernel layout is the ggml one, [OC][IC][KH][KW], so B[k, n] = w[n*K + k].
+template <int BM, int BN, int BK, int TM, int TN>
+static __global__ void __launch_bounds__((BM / TM) * (BN / TN))
+conv2d_igemm_f32(const float * __restrict__ x, const float * __restrict__ w, float * __restrict__ y,
+                 const conv_params P) {
+    constexpr int NT = (BM / TM) * (BN / TN);
+    constexpr int TX = BM / TM;   // threads along m
+    constexpr int TY = BN / TN;   // threads along n
+    constexpr int GM = TM / 4;    // float4 groups along m
+    constexpr int GN = TN / 4;    // float4 groups along n
+    static_assert(TM % 4 == 0 && TN % 4 == 0, "register tile");
+    static_assert(NT % BM == 0 && NT % BK == 0, "tile shape");
+    constexpr int A_STEP = NT / BM;              // A rows loaded per pass
+    constexpr int A_LOADS = BK / A_STEP;         // A loads per thread and slice
+    constexpr int B_STEP = NT / BK;              // B columns loaded per pass
+    constexpr int B_LOADS = BN / B_STEP;         // B loads per thread and slice
+    constexpr int BS = BN + 4;                   // padded B row (keeps float4 alignment)
+
+    __shared__ __align__(16) float As[2][BK][BM];
+    __shared__ __align__(16) float Bs[2][BK][BS];
+
+    const int IW = (int) P.IW, IH = (int) P.IH, OW = (int) P.OW, OH = (int) P.OH;
+    const int KW = (int) P.KW, KHW = (int) (P.KH * P.KW), IC = (int) P.IC, OC = (int) P.OC;
+    GGML_UNUSED(IC);
+    const int M = OW * OH * (int) P.B;
+    const int K = IC * KHW;
+
+    const int tid = threadIdx.x;
+    const int tx  = tid % TX;
+    const int ty  = tid / TX;
+    const int m0  = blockIdx.x * BM;
+    const int n0  = blockIdx.y * BN;
+
+    // The A column this thread loads is fixed: decode its pixel once.
+    const int  a_col = tid % BM;
+    const int  a_m   = m0 + a_col;
+    const bool a_ok  = a_m < M;
+    int a_ow = 0, a_oh = 0, a_b = 0;
+    if (a_ok) {
+        a_ow = a_m % OW;
+        a_oh = (a_m / OW) % OH;
+        a_b  = a_m / (OW * OH);
+    }
+    const float * xb  = x + (int64_t) a_b * IC * IH * IW;
+    const int     iy0 = a_oh * (int) P.ST_Y - (int) P.PD_Y;
+    const int     ix0 = a_ow * (int) P.ST_X - (int) P.PD_X;
+    const int     b_kk = tid % BK;
+    const int     b_nn = tid / BK;
+
+    // The k values this thread gathers for A advance by A_STEP from one load
+    // to the next (across slices too), so (ic, ky, kx) is kept as a running
+    // counter instead of two integer divisions per load.
+    const int KH   = (int) P.KH;
+    const int DL_X = (int) P.DL_X, DL_Y = (int) P.DL_Y;
+    int c_k  = tid / BM;
+    int c_ic = c_k / KHW;
+    int c_ky = (c_k - c_ic * KHW) / KW;
+    int c_kx = c_k - c_ic * KHW - c_ky * KW;
+
+    float ra[A_LOADS], rb[B_LOADS];
+    auto fetch = [&](const int k0) {
+#pragma unroll
+        for (int r = 0; r < A_LOADS; ++r) {
+            float v = 0.0f;
+            if (a_ok && c_k < K) {
+                const int iy = iy0 + c_ky * DL_Y;
+                const int ix = ix0 + c_kx * DL_X;
+                if (iy >= 0 && iy < IH && ix >= 0 && ix < IW) {
+                    v = xb[((int64_t) c_ic * IH + iy) * IW + ix];
+                }
+            }
+            ra[r] = v;
+            c_k  += A_STEP;
+            c_kx += A_STEP;
+            while (c_kx >= KW) {
+                c_kx -= KW;
+                if (++c_ky == KH) {
+                    c_ky = 0;
+                    ++c_ic;
+                }
+            }
+        }
+#pragma unroll
+        for (int r = 0; r < B_LOADS; ++r) {
+            const int n = n0 + b_nn + r * B_STEP;
+            const int k = k0 + b_kk;
+            rb[r] = (n < OC && k < K) ? w[(int64_t) n * K + k] : 0.0f;
+        }
+    };
+    auto stash = [&](const int buf) {
+#pragma unroll
+        for (int r = 0; r < A_LOADS; ++r) {
+            As[buf][tid / BM + r * A_STEP][a_col] = ra[r];
+        }
+#pragma unroll
+        for (int r = 0; r < B_LOADS; ++r) {
+            Bs[buf][b_kk][b_nn + r * B_STEP] = rb[r];
+        }
+    };
+
+    float acc[TM][TN];
+#pragma unroll
+    for (int i = 0; i < TM; ++i) {
+#pragma unroll
+        for (int j = 0; j < TN; ++j) {
+            acc[i][j] = 0.0f;
+        }
+    }
+
+    fetch(0);
+    stash(0);
+    __syncthreads();
+    int buf = 0;
+    for (int k0 = 0; k0 < K; k0 += BK) {
+        const bool more = k0 + BK < K;
+        if (more) {
+            fetch(k0 + BK);
+        }
+#pragma unroll
+        for (int kk = 0; kk < BK; ++kk) {
+            float a[TM], b[TN];
+#pragma unroll
+            for (int g = 0; g < GM; ++g) {
+                const float4 v = *reinterpret_cast<const float4 *>(&As[buf][kk][tx * 4 + g * TX * 4]);
+                a[4 * g + 0] = v.x; a[4 * g + 1] = v.y; a[4 * g + 2] = v.z; a[4 * g + 3] = v.w;
+            }
+#pragma unroll
+            for (int h = 0; h < GN; ++h) {
+                const float4 v = *reinterpret_cast<const float4 *>(&Bs[buf][kk][ty * 4 + h * TY * 4]);
+                b[4 * h + 0] = v.x; b[4 * h + 1] = v.y; b[4 * h + 2] = v.z; b[4 * h + 3] = v.w;
+            }
+#pragma unroll
+            for (int i = 0; i < TM; ++i) {
+#pragma unroll
+                for (int j = 0; j < TN; ++j) {
+                    acc[i][j] = __fmaf_rn(a[i], b[j], acc[i][j]);
+                }
+            }
+        }
+        if (more) {
+            stash(buf ^ 1);
+        }
+        __syncthreads();
+        buf ^= 1;
+    }
+
+#pragma unroll
+    for (int i = 0; i < TM; ++i) {
+        const int m = m0 + tx * 4 + (i / 4) * TX * 4 + (i % 4);
+        if (m >= M) {
+            continue;
+        }
+        const int ow = m % OW;
+        const int oh = (m / OW) % OH;
+        const int b  = m / (OW * OH);
+        float * yb = y + ((int64_t) b * OC * OH + oh) * OW + ow;
+#pragma unroll
+        for (int j = 0; j < TN; ++j) {
+            const int n = n0 + ty * 4 + (j / 4) * TY * 4 + (j % 4);
+            if (n < OC) {
+                yb[(int64_t) n * OH * OW] = acc[i][j];
+            }
+        }
+    }
+}
+
+template <int BM, int BN, int BK, int TM, int TN>
+static void conv2d_igemm_f32_cuda(const float * X_D, const float * K_D, float * Y_D, const conv_params P,
+                                  cudaStream_t st) {
+    const int64_t M = P.OW * P.OH * P.B;
+    const dim3 grid((unsigned) ((M + BM - 1) / BM), (unsigned) ((P.OC + BN - 1) / BN), 1);
+    conv2d_igemm_f32<BM, BN, BK, TM, TN><<<grid, (BM / TM) * (BN / TN), 0, st>>>(X_D, K_D, Y_D, P);
+}
+#endif // GGML_CUDA_CONV2D_IGEMM
+
 static void conv2d_cuda_f32(const float * X_D, const float * K_D, float * Y_D, const conv_params P, cudaStream_t st) {
+#ifdef GGML_CUDA_CONV2D_IGEMM
+    // The direct kernel below has no data reuse; the implicit GEMM is much
+    // faster once there are enough output channels to fill a tile.
+    if (P.OC > 8 && P.OW * P.OH * P.B < INT32_MAX && P.IC * P.KH * P.KW < INT32_MAX &&
+        P.IW * P.IH * P.IC * P.B < INT32_MAX) {
+        // Small images with many channels (the first decoder levels) get
+        // narrow tiles, so that the grid still fills the GPU.
+        const int64_t M = P.OW * P.OH * P.B;
+        if (P.OC <= 32) {
+            conv2d_igemm_f32_cuda<128, 32, 16, 8, 4>(X_D, K_D, Y_D, P, st);
+        } else if (((M + 127) / 128) * ((P.OC + 63) / 64) < 160) {
+            conv2d_igemm_f32_cuda<32, 64, 16, 4, 4>(X_D, K_D, Y_D, P, st);
+        } else {
+            conv2d_igemm_f32_cuda<128, 64, 16, 8, 8>(X_D, K_D, Y_D, P, st);
+        }
+        return;
+    }
+#endif
     conv2d_cuda<float>(X_D, K_D, Y_D, P, st);
 }
 
