+#pragma once
+#include "common.cuh"
+
+// Direct F32 convolution with a shared-memory input tile, for the shapes of
+// a StyleGAN2-like decoder: stride 1, dilation 1, kernels up to 3 x 3, and
+// the stride-2 3 x 3 transposed convolution split into its four output
+// phases. Optional per-channel input scale (the modulation, applied to every
+// input value before the multiply), per-channel output scale (the
+// demodulation), per-channel bias and leaky ReLU in the epilogue.
+//
+// Every output is one fused multiply-add chain over (input channel, kernel
+// row, kernel column) in this order, starting at 0, in float32. The
+// prologue and the epilogue round each operation as the separate MUL, ADD
+// and LEAKY_RELU kernels do, so a fused call gives the same bits as the
+// separate ops followed by the implicit-GEMM convolution of conv2d.cu.
+
+// Channel vector [1, 1, C, 1 or B] (scale or bias) of a fused call.
+struct conv_tile_vec {
+    const float * d  = nullptr;
+    int           sb = 0;   // stride between batches (0: one vector for all)
+};
+
+// in_scale, out_scale, bias: [1, 1, C, 1 or B] tensors or nullptr.
+// leaky: apply leaky ReLU with this slope after the bias (when has_leaky).
+bool ggml_cuda_conv2d_tile_supported(const ggml_tensor * conv);
+void ggml_cuda_conv2d_tile(ggml_backend_cuda_context & ctx, const ggml_tensor * conv, const ggml_tensor * x,
+                           const ggml_tensor * in_scale, const ggml_tensor * out_scale, const ggml_tensor * bias,
+                           bool has_leaky, float slope, ggml_tensor * dst);
+
+// GGML_OP_CONV_TRANSPOSE_2D with a 3 x 3 kernel and stride 2 (any kernel
+// strides, so a permuted view works).
+bool ggml_cuda_conv_transpose_s2_supported(const ggml_tensor * convt);
+void ggml_cuda_conv_transpose_s2(ggml_backend_cuda_context & ctx, const ggml_tensor * convt, const ggml_tensor * x,
+                                 const ggml_tensor * in_scale, const ggml_tensor * out_scale, ggml_tensor * dst);
+
+// True when t is a contiguous F32 channel vector [1, 1, C, 1 or B] for an
+// activation of shape [., ., C, B].
+bool ggml_cuda_conv_tile_chan_vec_ok(const ggml_tensor * t, int64_t C, int64_t B);
