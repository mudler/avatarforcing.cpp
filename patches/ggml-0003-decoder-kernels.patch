@@ -73,3 +73,62 @@ void ggml_cuda_op_chan_affine_leaky(ggml_backend_cuda_context & ctx, const ggml_
         n, hw, (int) x->ne[2], m ? (int) m->ne[2] : 1, m ? (int) m->ne[3] : 1, (int) a->ne[2], (int) a->ne[3],
         negative_slope);
 }
+
+// dst = o + x * m, with m [W, H, 1, B] broadcast over the channels (the
+// warp update x' = warp + x * (1 - mask) of a flow decoder). Each operation
+// is rounded as in the separate MUL and ADD kernels.
+// grid: (pixel blocks, C * B planes)
+static __global__ void mul_mask_add_f32(const float * __restrict__ x, const float * __restrict__ m,
+                                        const float * __restrict__ o, float * __restrict__ dst, const int hw,
+                                        const int C) {
+    const int pix = blockIdx.x * blockDim.x + threadIdx.x;
+    if (pix >= hw) {
+        return;
+    }
+    const int     plane = blockIdx.y;
+    const int64_t i     = (int64_t) plane * hw + pix;
+    dst[i] = __fadd_rn(o[i], __fmul_rn(x[i], m[(int64_t) (plane / C) * hw + pix]));
+}
+
+bool ggml_cuda_mul_mask_add_supported(const ggml_tensor * mul, const ggml_tensor * add) {
+    const ggml_tensor * x = mul->src[0];
+    const ggml_tensor * m = mul->src[1];
+    const ggml_tensor * o = add->src[0] == mul ? add->src[1] : add->src[0];
+    if (add->src[0] != mul && add->src[1] != mul) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || m->type != GGML_TYPE_F32 || o->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+        add->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_is_contiguous(x) || !ggml_is_contiguous(m) || !ggml_is_contiguous(o) || !ggml_is_contiguous(add)) {
+        return false;
+    }
+    if (!ggml_are_same_shape(x, mul) || !ggml_are_same_shape(o, add) || !ggml_are_same_shape(mul, add)) {
+        return false;
+    }
+    if (m->ne[0] != x->ne[0] || m->ne[1] != x->ne[1] || m->ne[2] != 1 || m->ne[3] != x->ne[3]) {
+        return false;
+    }
+    if (x->ne[0] * x->ne[1] >= INT32_MAX || x->ne[2] * x->ne[3] > 65535) {
+        return false;   // grid limits
+    }
+    // element-wise: the output may coincide exactly with x or o, but must
+    // not overlap them otherwise, nor the mask
+    if ((add->data != x->data && ranges_overlap(add, x)) || (add->data != o->data && ranges_overlap(add, o)) ||
+        ranges_overlap(add, m)) {
+        return false;
+    }
+    return true;
+}
+
+void ggml_cuda_op_mul_mask_add(ggml_backend_cuda_context & ctx, const ggml_tensor * mul, ggml_tensor * add) {
+    const ggml_tensor * x = mul->src[0];
+    const ggml_tensor * m = mul->src[1];
+    const ggml_tensor * o = add->src[0] == mul ? add->src[1] : add->src[0];
+    const int hw = (int) (x->ne[0] * x->ne[1]);
+    const dim3 grid((hw + CUDA_CHAN_AFFINE_BLOCK_SIZE - 1) / CUDA_CHAN_AFFINE_BLOCK_SIZE, (unsigned) (x->ne[2] * x->ne[3]));
+    mul_mask_add_f32<<<grid, CUDA_CHAN_AFFINE_BLOCK_SIZE, 0, ctx.stream()>>>(
+        (const float *) x->data, (const float *) m->data, (const float *) o->data, (float *) add->data, hw,
+        (int) x->ne[2]);
+}
